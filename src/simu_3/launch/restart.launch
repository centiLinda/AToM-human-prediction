<launch>
    <rosparam file="$(find ilq_solver)/config/3_2AgentDoorway_config.yaml" command="load" />
    <node pkg="simu_3" type="robot_narrow_door.py" name="robot" output="screen"/>
    <node pkg="simu_3" type="human_narrow_door.py" name="human" output="screen" />
    <node pkg="simu_3" type="mpc_narrow_door.py" name="mpc" output="screen"/>
    <node pkg="simu_3" type="viz_narrow_door.py" name="viz" output="screen"/>
</launch>